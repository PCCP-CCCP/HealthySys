    <shape type="text" topLeftX="60" topLeftY="486" width="840" height="36">
      <content textType="body" fontSize="16" fontFamily="思源黑体" color="rgba(0,48,135,1)" textAlign="left" wrap="false">
        <p>技术选型：<span fontFamily="Roboto Mono" color="rgba(71,85,105,1)">Java Swing</span> · <span fontFamily="Roboto Mono" color="rgba(71,85,105,1)">MySQL 8</span> · <span fontFamily="Roboto Mono" color="rgba(71,85,105,1)">JDBC</span> · <span fontFamily="Roboto Mono" color="rgba(71,85,105,1)">Maven</span></p>
      </content>
